# PostgreSQL 数据库配置
# 库名已在 docker-compose.yml 中固定为 jvlink（统一数据库），此处无需配置
DB_USER=your_database_user
DB_PASSWORD=your_secure_password
DB_HOST=your_database_host
DB_PORT=5432

# Redis 缓存配置（多个应用可共享同一 Redis 实例，通过不同 DB 编号隔离）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=            # 可选，如果 Redis 设置了密码
REDIS_DB=0                 # 每个应用使用不同的 DB 编号（0-15），实现数据隔离
CACHE_TTL=3600             # 缓存过期时间（秒），默认 1 小时
MV_REFRESH_INTERVAL=3600   # 物化视图刷新间隔（秒），刷新后自动清理缓存

# Docker Compose 配置
COMPOSE_PROJECT_NAME=rival-map
